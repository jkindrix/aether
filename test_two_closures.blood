// Test two closures (not nested, just two separate calls)

effect Emit<T> {
    op emit(value: T) -> ();
}

fn emit_123() / {Emit<i32>} {
    perform Emit.emit(1);
    perform Emit.emit(2);
    perform Emit.emit(3);
}

fn run_stream(stream: fn() / {Emit<i32>}) -> i32 {
    let mut total: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + value;
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // Two separate calls, not nested
    let a: i32 = run_stream(|| / {Emit<i32>} { emit_123(); });
    let b: i32 = run_stream(|| / {Emit<i32>} { emit_123(); });
    a + b  // Should be 6 + 6 = 12
}
