// Test inline handler without capturing outer variables

effect Emit<T> {
    op emit(value: T) -> ();
}

fn emit_numbers() / {Emit<i32>} {
    perform Emit.emit(10);
    perform Emit.emit(20);
    perform Emit.emit(30);
}

fn main() {
    let result = try {
        emit_numbers();
        42
    } with {
        Emit.emit(value) => {
            // Just resume without capturing anything
            resume(());
        }
    };
    // result should be 42
}
