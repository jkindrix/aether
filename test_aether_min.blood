// Minimal Aether test

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn square(x: i32) -> i32 {
    x * x
}

fn is_even(x: i32) -> bool {
    x % 2 == 0
}

fn main() -> i32 {
    // sum of squares of evens from 1..5 = 4 + 16 = 20
    let result: i64 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} {
            filter(|| / {Emit<i32>} {
                range(1, 5);
            }, is_even);
        }, square);
    });
    result as i32
}
