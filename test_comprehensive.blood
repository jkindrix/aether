// Comprehensive Aether tests

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn take<T>(stream: fn() / {Emit<T>}, n: i32) / {Emit<T>} {
    let mut count: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            if count < n {
                perform Emit.emit(value);
                count = count + 1;
                resume(());
            }
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i32 {
    let mut total: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + value;
            resume(());
        }
    };
    total
}

fn square(x: i32) -> i32 { x * x }
fn is_even(x: i32) -> bool { x % 2 == 0 }

fn main() -> i32 {
    // Test 1: sum(1..11) = 55
    let t1: i32 = sum(|| / {Emit<i32>} { range(1, 11); });

    // Test 2: sum of squares of 1..4 = 1+4+9 = 14
    let t2: i32 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} { range(1, 4); }, square);
    });

    // Test 3: sum of evens from 1..10 = 2+4+6+8 = 20
    let t3: i32 = sum(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(1, 10); }, is_even);
    });

    // Test 4: sum of first 5 from 1..100 = 1+2+3+4+5 = 15
    let t4: i32 = sum(|| / {Emit<i32>} {
        take(|| / {Emit<i32>} { range(1, 100); }, 5);
    });

    // Test 5: sum of squares of evens from 1..6 = 4+16 = 20
    let t5: i32 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} {
            filter(|| / {Emit<i32>} { range(1, 6); }, is_even);
        }, square);
    });

    // Verify all tests
    // Expected: t1=55, t2=14, t3=20, t4=15, t5=20
    // Return 0 if all pass, otherwise return which test failed

    if t1 != 55 { return 1; }
    if t2 != 14 { return 2; }
    if t3 != 20 { return 3; }
    if t4 != 15 { return 4; }
    if t5 != 20 { return 5; }

    0  // All tests passed!
}
