// Simple map test - direct handling

effect Emit<T> {
    op emit(value: T) -> ();
}

fn emit_three() / {Emit<i32>} {
    perform Emit.emit(1);
    perform Emit.emit(2);
    perform Emit.emit(3);
}

fn double(x: i32) -> i32 {
    x * 2
}

fn main() -> i32 {
    let mut total: i32 = 0;

    // Manual map: handle emit, transform, and accumulate
    try { emit_three(); }
    with {
        Emit.emit(value) => {
            total = total + double(value);
            resume(());
        }
    };

    total  // Should be 2 + 4 + 6 = 12
}
