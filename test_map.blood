// Test map operator with re-emit

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map_i32(stream: fn() / {Emit<i32>}, f: fn(i32) -> i32) / {Emit<i32>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn sum_i32(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn square(x: i32) -> i32 {
    x * x
}

fn main() -> i32 {
    // sum of squares of 1..4 = 1 + 4 + 9 = 14
    let s: i64 = sum_i32(|| / {Emit<i32>} {
        map_i32(|| / {Emit<i32>} { range(1, 4); }, square);
    });
    s as i32
}
