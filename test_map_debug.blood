// Debug map - check if it's actually transforming

effect Emit<T> {
    op emit(value: T) -> ();
}

fn emit_three() / {Emit<i32>} {
    perform Emit.emit(1);
    perform Emit.emit(2);
    perform Emit.emit(3);
}

fn map_i32(stream: fn() / {Emit<i32>}, f: fn(i32) -> i32) / {Emit<i32>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn double(x: i32) -> i32 {
    x * 2
}

fn sum_i32(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // Without map: 1 + 2 + 3 = 6
    // With map (double): 2 + 4 + 6 = 12
    let s: i64 = sum_i32(|| / {Emit<i32>} {
        map_i32(|| / {Emit<i32>} { emit_three(); }, double);
    });
    s as i32
}
