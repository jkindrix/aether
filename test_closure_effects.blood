// Test case: Closure with explicit effect annotations

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Test 1: Closure with explicit effect annotation
fn test_explicit_closure() -> i64 {
    sum(|| -> () / {Emit<i32>} { range(1, 11); })
}

// Test 2: What about without return type?
fn test_implicit_return() -> i64 {
    sum(|| / {Emit<i32>} { range(1, 11); })
}

fn main() {
    let s1: i64 = test_explicit_closure();
}
