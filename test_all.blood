// Comprehensive Aether tests - all operators

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn take<T>(stream: fn() / {Emit<T>}, n: i32) / {Emit<T>} {
    let mut count: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            if count < n {
                perform Emit.emit(value);
                count = count + 1;
                resume(());
            }
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i32 {
    let mut total: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + value;
            resume(());
        }
    };
    total
}

fn count<T>(stream: fn() / {Emit<T>}) -> i32 {
    let mut n: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(_value) => {
            n = n + 1;
            resume(());
        }
    };
    n
}

fn square(x: i32) -> i32 { x * x }
fn is_even(x: i32) -> bool { x % 2 == 0 }
fn is_prime(n: i32) -> bool {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    let mut d: i32 = 3;
    while d * d <= n {
        if n % d == 0 { return false; }
        d = d + 2;
    }
    true
}

fn main() -> i32 {
    // Test 1: sum(1..11) = 55
    let t1: i32 = sum(|| / {Emit<i32>} { range(1, 11); });
    if t1 != 55 { return 1; }

    // Test 2: sum of squares of 1..4 = 1+4+9 = 14
    let t2: i32 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} { range(1, 4); }, square);
    });
    if t2 != 14 { return 2; }

    // Test 3: sum of evens from 1..10 = 2+4+6+8 = 20
    let t3: i32 = sum(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(1, 10); }, is_even);
    });
    if t3 != 20 { return 3; }

    // Test 4: sum of first 5 from 1..100 = 1+2+3+4+5 = 15
    let t4: i32 = sum(|| / {Emit<i32>} {
        take(|| / {Emit<i32>} { range(1, 100); }, 5);
    });
    if t4 != 15 { return 4; }

    // Test 5: sum of squares of evens from 1..11 = 4+16+36+64+100 = 220
    let t5: i32 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} {
            filter(|| / {Emit<i32>} { range(1, 11); }, is_even);
        }, square);
    });
    if t5 != 220 { return 5; }

    // Test 6: count of 1..11 = 10
    let t6: i32 = count(|| / {Emit<i32>} { range(1, 11); });
    if t6 != 10 { return 6; }

    // Test 7: count of primes up to 20 = 8 (2,3,5,7,11,13,17,19)
    let t7: i32 = count(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(2, 20); }, is_prime);
    });
    if t7 != 8 { return 7; }

    0  // All tests passed!
}
