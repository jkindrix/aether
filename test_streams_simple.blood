// Simplified Aether test - non-generic versions only

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

// Non-generic sum
fn sum_i32(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Non-generic count
fn count_i32(stream: fn() / {Emit<i32>}) -> i64 {
    let mut n: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            n = n + 1i64;
            resume(());
        }
    };
    n
}

fn main() -> i32 {
    // Test: sum of 1..11 = 55
    let s1: i64 = sum_i32(|| / {Emit<i32>} { range(1, 11); });

    // Test: count of 1..11 = 10
    let c1: i64 = count_i32(|| / {Emit<i32>} { range(1, 11); });

    // Return sum as exit code (truncated to i32)
    s1 as i32
}
