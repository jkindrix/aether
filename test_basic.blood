// Basic inline handler test - no generics

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

// Non-generic sum - directly handles Emit<i32>
fn sum_range(start: i32, end: i32) -> i64 {
    let mut total: i64 = 0;
    try { range(start, end); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() {
    let s1: i64 = sum_range(1, 11);  // Should be 55
    // Return via exit code for testing
}
