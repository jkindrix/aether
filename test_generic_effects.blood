// =============================================================================
// Minimal Test Case: Generic Type Parameters in Effect Annotations
// =============================================================================
//
// BUG: Type parameters declared on a function are not in scope when
//      processing the effect annotation part of the signature.
//
// To test: blood check test_generic_effects.blood
//
// Expected: All functions should type-check successfully
// Actual: "cannot find type `T` in this scope" for effect annotations
//

// Effect declaration (this works fine)
effect Emit<T> {
    op emit(value: T) -> ();
}

// -----------------------------------------------------------------------------
// TEST 1: Simple generic function with effect
// -----------------------------------------------------------------------------
// Error: cannot find type `T` in this scope (in effect annotation)
fn emit_one<T>(value: T) / {Emit<T>} {
    perform Emit.emit(value);
}

// -----------------------------------------------------------------------------
// TEST 2: Generic function taking effectful function parameter
// -----------------------------------------------------------------------------
// Error: cannot find type `T` in this scope (in both places)
fn run_stream<T>(stream: fn() / {Emit<T>}) / {Emit<T>} {
    stream();
}

// -----------------------------------------------------------------------------
// TEST 3: Multiple type parameters
// -----------------------------------------------------------------------------
// Error: cannot find type `T` or `U` in effect annotations
fn transform<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    // Would use try/with handler here
}

// -----------------------------------------------------------------------------
// TEST 4: Concrete types (WORKAROUND - should work)
// -----------------------------------------------------------------------------
fn emit_i32(value: i32) / {Emit<i32>} {
    perform Emit.emit(value);
}

fn run_i32_stream(stream: fn() / {Emit<i32>}) / {Emit<i32>} {
    stream();
}

// -----------------------------------------------------------------------------
// TEST 5: Generic with row polymorphism
// -----------------------------------------------------------------------------
// Error: cannot find type `T` in effect annotation
fn emit_poly<T, E>(value: T) / {Emit<T> | E} {
    perform Emit.emit(value);
}

// -----------------------------------------------------------------------------
// ANALYSIS
// -----------------------------------------------------------------------------
//
// The pattern is clear:
//   fn foo<T>(x: T) -> T          // T works in params and return
//   fn foo<T>(x: T) / {Emit<T>}   // T works in params, FAILS in effects
//
// The type parameter scope doesn't extend to the effect annotation.
//
// This blocks ALL generic effect-based programming.
