// Simplest filter test with inline lambda

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // Direct filter with inline lambda, no capture
    let result: i64 = sum(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(1, 11); }, |x: i32| -> bool { x % 2 == 0 });
    });

    // Should be 2+4+6+8+10 = 30
    if result == 30 { return 0; }
    if result == 55 { return 55; }
    if result == 0 { return 99; }
    (result as i32)
}
