// =============================================================================
// Aether: Stream Operators
// =============================================================================
//
// Operators transform streams by intercepting Emit effects and re-emitting
// transformed values. This creates composable, type-safe pipelines.
//

// -----------------------------------------------------------------------------
// Mapping Operators
// -----------------------------------------------------------------------------

/// Transform each element with a function.
/// map(stream, f) emits f(x) for each x in stream.
fn map<T, U>(stream: fn() / {Emit<T>}, transform: fn(T) -> U) / {Emit<U>} {
    handle stream() {
        Emit.emit(value) => {
            let transformed: U = transform(value);
            perform Emit.emit(transformed);
            resume(());
        }
    };
}

/// Transform each element with access to its index.
fn map_indexed<T, U>(stream: fn() / {Emit<T>}, transform: fn(T, i64) -> U) / {Emit<U>} {
    let mut index: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            let transformed: U = transform(value, index);
            perform Emit.emit(transformed);
            index = index + 1;
            resume(());
        }
    };
}

/// Emit a constant value for each input element (ignoring input values).
fn map_const<T, U>(stream: fn() / {Emit<T>}, constant: U) / {Emit<U>} {
    handle stream() {
        Emit.emit(_value) => {
            perform Emit.emit(constant);
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Filtering Operators
// -----------------------------------------------------------------------------

/// Keep only elements satisfying a predicate.
fn filter<T>(stream: fn() / {Emit<T>}, predicate: fn(T) -> bool) / {Emit<T>} {
    handle stream() {
        Emit.emit(value) => {
            if predicate(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

/// Keep elements that do NOT satisfy the predicate.
fn filter_not<T>(stream: fn() / {Emit<T>}, predicate: fn(T) -> bool) / {Emit<T>} {
    handle stream() {
        Emit.emit(value) => {
            if !predicate(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

/// Filter and transform in one pass (emit only when Some).
fn filter_map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> Option<U>) / {Emit<U>} {
    handle stream() {
        Emit.emit(value) => {
            match f(value) {
                Option::Some(transformed) => {
                    perform Emit.emit(transformed);
                },
                Option::None => {
                    // Skip this element
                },
            }
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Taking/Dropping Operators
// -----------------------------------------------------------------------------

/// Take only the first n elements.
fn take<T>(stream: fn() / {Emit<T>}, n: i64) / {Emit<T>} {
    let mut count: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            if count < n {
                perform Emit.emit(value);
                count = count + 1;
                resume(());
            }
            // Don't resume after n elements - terminates early
        }
    };
}

/// Take elements while predicate is true, stop when first false.
fn take_while<T>(stream: fn() / {Emit<T>}, predicate: fn(T) -> bool) / {Emit<T>} {
    let mut taking: bool = true;

    handle stream() {
        Emit.emit(value) => {
            if taking && predicate(value) {
                perform Emit.emit(value);
                resume(());
            } else {
                taking = false;
                // Stop - don't resume
            }
        }
    };
}

/// Skip the first n elements, emit the rest.
fn drop<T>(stream: fn() / {Emit<T>}, n: i64) / {Emit<T>} {
    let mut skipped: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            if skipped >= n {
                perform Emit.emit(value);
            } else {
                skipped = skipped + 1;
            }
            resume(());
        }
    };
}

/// Skip elements while predicate is true, emit rest.
fn drop_while<T>(stream: fn() / {Emit<T>}, predicate: fn(T) -> bool) / {Emit<T>} {
    let mut dropping: bool = true;

    handle stream() {
        Emit.emit(value) => {
            if dropping {
                if predicate(value) {
                    // Still dropping
                } else {
                    dropping = false;
                    perform Emit.emit(value);
                }
            } else {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

/// Take every nth element (1-indexed: step=2 takes elements 1, 3, 5, ...).
fn step_by<T>(stream: fn() / {Emit<T>}, step: i64) / {Emit<T>} {
    let mut count: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            if count % step == 0 {
                perform Emit.emit(value);
            }
            count = count + 1;
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Scanning Operators (running reductions)
// -----------------------------------------------------------------------------

/// Emit running totals: scan(+, 0) on [1,2,3] -> [1, 3, 6]
fn scan<T, R>(
    stream: fn() / {Emit<T>},
    initial: R,
    combine: fn(R, T) -> R
) / {Emit<R>} {
    let mut acc: R = initial;

    handle stream() {
        Emit.emit(value) => {
            acc = combine(acc, value);
            perform Emit.emit(acc);
            resume(());
        }
    };
}

/// Running sum of integers.
fn running_sum(stream: fn() / {Emit<i32>}) / {Emit<i64>} {
    let mut sum: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            sum = sum + (value as i64);
            perform Emit.emit(sum);
            resume(());
        }
    };
}

/// Running average (emit current average after each element).
fn running_average(stream: fn() / {Emit<i32>}) / {Emit<i32>} {
    let mut sum: i64 = 0;
    let mut count: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            sum = sum + (value as i64);
            count = count + 1;
            let avg: i32 = (sum / count) as i32;
            perform Emit.emit(avg);
            resume(());
        }
    };
}

/// Running maximum (emit current max after each element).
fn running_max(stream: fn() / {Emit<i32>}) / {Emit<i32>} {
    let mut max_val: i32 = -2147483648;

    handle stream() {
        Emit.emit(value) => {
            if value > max_val {
                max_val = value;
            }
            perform Emit.emit(max_val);
            resume(());
        }
    };
}

/// Running minimum (emit current min after each element).
fn running_min(stream: fn() / {Emit<i32>}) / {Emit<i32>} {
    let mut min_val: i32 = 2147483647;

    handle stream() {
        Emit.emit(value) => {
            if value < min_val {
                min_val = value;
            }
            perform Emit.emit(min_val);
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Deduplication Operators
// -----------------------------------------------------------------------------

/// Remove consecutive duplicates.
/// [1, 1, 2, 2, 2, 1, 1] -> [1, 2, 1]
fn dedup(stream: fn() / {Emit<i32>}) / {Emit<i32>} {
    let mut last: i32 = 0;
    let mut has_last: bool = false;

    handle stream() {
        Emit.emit(value) => {
            if !has_last || value != last {
                perform Emit.emit(value);
                last = value;
                has_last = true;
            }
            resume(());
        }
    };
}

/// Remove consecutive duplicates based on a key function.
fn dedup_by<T, K>(
    stream: fn() / {Emit<T>},
    key_fn: fn(T) -> K
) / {Emit<T>} {
    let mut last_key: Option<K> = Option::None;

    handle stream() {
        Emit.emit(value) => {
            let key: K = key_fn(value);
            let should_emit: bool = match last_key {
                Option::None => true,
                Option::Some(prev_key) => key != prev_key,
            };
            if should_emit {
                perform Emit.emit(value);
                last_key = Option::Some(key);
            }
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Enumeration Operators
// -----------------------------------------------------------------------------

/// Pair each element with its index.
struct Indexed<T> {
    index: i64,
    value: T,
}

fn enumerate<T>(stream: fn() / {Emit<T>}) / {Emit<Indexed<T>>} {
    let mut index: i64 = 0;

    handle stream() {
        Emit.emit(value) => {
            perform Emit.emit(Indexed { index: index, value: value });
            index = index + 1;
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Chunking Operators
// -----------------------------------------------------------------------------

/// Emit chunks of n elements each.
/// Note: Last chunk may have fewer than n elements.
/// For simplicity, this emits a "chunk marker" between chunks.
struct ChunkMarker {
    chunk_index: i64,
    element_index: i64,
    is_chunk_end: bool,
}

fn chunk_markers(stream: fn() / {Emit<i32>}, chunk_size: i64) / {Emit<ChunkMarker>} {
    let mut chunk_idx: i64 = 0;
    let mut elem_idx: i64 = 0;

    handle stream() {
        Emit.emit(_value) => {
            perform Emit.emit(ChunkMarker {
                chunk_index: chunk_idx,
                element_index: elem_idx,
                is_chunk_end: (elem_idx + 1) % chunk_size == 0,
            });
            elem_idx = elem_idx + 1;
            if elem_idx % chunk_size == 0 {
                chunk_idx = chunk_idx + 1;
            }
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Flattening Operators
// -----------------------------------------------------------------------------

/// Flatten nested emissions by emitting each element of inner stream.
/// flat_map applies f to each element and emits all results from f.
fn flat_map<T, U>(
    stream: fn() / {Emit<T>},
    f: fn(T) / {Emit<U>}
) / {Emit<U>} {
    handle stream() {
        Emit.emit(value) => {
            // For each input value, run f which may emit multiple U values
            // Those emissions propagate to our handler's context
            f(value);
            resume(());
        }
    };
}

// -----------------------------------------------------------------------------
// Inspection Operators (for debugging)
// -----------------------------------------------------------------------------

/// Peek at each element without modifying the stream.
/// Useful for debugging or side effects.
fn inspect<T>(stream: fn() / {Emit<T>}, inspector: fn(T) -> ()) / {Emit<T>} {
    handle stream() {
        Emit.emit(value) => {
            inspector(value);
            perform Emit.emit(value);
            resume(());
        }
    };
}

/// Count elements as they pass through (for progress tracking).
fn count_through<T>(stream: fn() / {Emit<T>}) -> (fn() / {Emit<T>}, fn() -> i64) {
    // This would require mutable shared state - simplified version below
    // Returns the stream unchanged
    stream
}
