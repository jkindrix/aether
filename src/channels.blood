// -----------------------------------------------------------------------------
// Effect Type Alias
// -----------------------------------------------------------------------------

// The full channel effect for typed operations.
// Users would declare: fn my_func() / {TypedChannel<MyType>}
//
// Note: Blood doesn't yet support effect aliases, so this is documentation:
//
// effect TypedChannel<T> = RawChannel<T>;
//
// This would allow:
//   fn producer() / {TypedChannel<SensorReading>} { ... }
//   fn consumer() / {TypedChannel<SensorReading>} { ... }

// -----------------------------------------------------------------------------
// Required Effect Declarations
// -----------------------------------------------------------------------------

effect Emit<T> {
    op emit(value: T) -> ();
}
