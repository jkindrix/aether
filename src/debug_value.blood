// Debug: determine actual value from capture

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Function that captures n
fn sum_range_to(n: i32) -> i64 {
    sum(|| / {Emit<i32>} {
        range(1, n + 1);
    })
}

fn main() -> i32 {
    let result: i64 = sum_range_to(10);

    // Return result truncated to i32 so we can see it
    // Expected: 55, so if we get 55 that means it works
    result as i32
}
