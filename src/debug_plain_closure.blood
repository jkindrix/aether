// Debug: does parameter capture work in plain closures (no effects)?

fn apply(f: fn() -> i32) -> i32 {
    f()
}

fn capture_n(n: i32) -> i32 {
    apply(|| { n })
}

fn main() -> i32 {
    let r1: i32 = capture_n(100);
    let r2: i32 = capture_n(77);

    // If both match input, captures work
    if r1 == 100 && r2 == 77 { return 0; }  // Correct!

    // Return difference to see the issue
    if r1 == r2 { return 1; }  // Same wrong value

    // Different but wrong
    2
}
