// Debug: test multiple capture values

effect Emit<T> {
    op emit(value: T) -> ();
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Emit n once to see what it is
fn emit_n(n: i32) -> i64 {
    sum(|| / {Emit<i32>} {
        perform Emit.emit(n);
    })
}

fn main() -> i32 {
    // Test different values
    let r1: i64 = emit_n(100);
    let r2: i64 = emit_n(200);

    // Return r1 + r2*1000 to see both values
    // Expected: 100 + 200000 = 200100
    (r1 + r2 * 1000) as i32
}
