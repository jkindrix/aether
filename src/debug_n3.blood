// Debug: does captured value change with input?

effect Emit<T> {
    op emit(value: T) -> ();
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Emit n once to see what it is
fn emit_n(n: i32) -> i64 {
    sum(|| / {Emit<i32>} {
        perform Emit.emit(n);
    })
}

fn main() -> i32 {
    // Check if result changes with input
    let r1: i64 = emit_n(100);
    let r2: i64 = emit_n(77);

    // If r1 == r2, both captured the same wrong value
    if r1 == r2 { return 1; }  // Same wrong value

    // If both match input, captures work
    if r1 == 100 && r2 == 77 { return 0; }  // Correct!

    // Different wrong values
    ((r1 * 1000 + r2) % 256) as i32
}
