// Debug: exact value check

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn sum_even_squares(n: i32) -> i64 {
    sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} {
            filter(|| / {Emit<i32>} {
                range(1, n + 1);
            }, |x: i32| -> bool { x % 2 == 0 });
        }, |x: i32| -> i32 { x * x });
    })
}

fn main() -> i32 {
    let s2: i64 = sum_even_squares(10);

    // Check specific values
    if s2 == 0 { return 10; }       // Zero
    if s2 == 55 { return 11; }      // Sum of 1..11
    if s2 == 220 { return 0; }      // Correct!
    if s2 == 385 { return 12; }     // Sum of squares 1..10

    // Return last byte of value
    ((s2 % 256) as i32) + 100
}
