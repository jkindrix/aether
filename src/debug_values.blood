// Debug: test with different values

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Function that captures n
fn sum_range_to(n: i32) -> i64 {
    sum(|| / {Emit<i32>} {
        range(1, n + 1);
    })
}

fn main() -> i32 {
    // Test with n=5: expected 1+2+3+4+5 = 15
    let r5: i64 = sum_range_to(5);
    if r5 != 15 { return r5 as i32 + 100; }  // Returns 100 + actual value if wrong

    0
}
