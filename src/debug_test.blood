// Debug test to isolate sum_even_squares issue

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn map<T, U>(stream: fn() / {Emit<T>}, f: fn(T) -> U) / {Emit<U>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            perform Emit.emit(f(value));
            resume(());
        }
    };
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

// Test sum of even squares step by step
fn main() -> i32 {
    // First test: just sum range 1..11 = 55
    let s1: i64 = sum(|| / {Emit<i32>} { range(1, 11); });
    if s1 != 55 { return 1; }

    // Second test: filter evens from 1..11 and sum = 2+4+6+8+10 = 30
    let s2: i64 = sum(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(1, 11); }, |x: i32| -> bool { x % 2 == 0 });
    });
    if s2 != 30 { return 2; }

    // Third test: map squares from 1..6 = 1+4+9+16+25 = 55
    let s3: i64 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} { range(1, 6); }, |x: i32| -> i32 { x * x });
    });
    if s3 != 55 { return 3; }

    // Fourth test: filter evens then map squares = 4+16+36+64+100 = 220
    let s4: i64 = sum(|| / {Emit<i32>} {
        map(|| / {Emit<i32>} {
            filter(|| / {Emit<i32>} { range(1, 11); }, |x: i32| -> bool { x % 2 == 0 });
        }, |x: i32| -> i32 { x * x });
    });
    if s4 != 220 { return 4; }

    0  // All passed
}
