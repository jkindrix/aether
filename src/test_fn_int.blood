// Test: generic function with effectful fn param + int param

effect Emit<T> {
    op emit(value: T) -> ();
}

// Generic function with effectful stream + int
fn repeat_stream<T>(stream: fn() / {Emit<T>}, times: i32) / {Emit<T>} {
    let mut i: i32 = 0;
    while i < times {
        stream();
        i = i + 1;
    }
}

fn emit_one() / {Emit<i32>} {
    perform Emit.emit(42);
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // repeat emit_one 3 times = 42*3 = 126
    let result: i64 = sum(|| / {Emit<i32>} { repeat_stream(emit_one, 3); });
    if result == 126 { return 0; }
    (result as i32)
}
