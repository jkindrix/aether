// Test filter-like pattern

effect Emit<T> {
    op emit(value: T) -> ();
}

fn filter<T>(stream: fn() / {Emit<T>}, pred: fn(T) -> bool) / {Emit<T>} {
    try { stream(); }
    with {
        Emit.emit(value) => {
            if pred(value) {
                perform Emit.emit(value);
            }
            resume(());
        }
    };
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn is_even(x: i32) -> bool {
    x % 2 == 0
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // Sum of evens from 1..11 = 2+4+6+8+10 = 30
    let result: i64 = sum(|| / {Emit<i32>} {
        filter(|| / {Emit<i32>} { range(1, 11); }, is_even);
    });
    if result == 30 { return 0; }
    (result as i32)
}
