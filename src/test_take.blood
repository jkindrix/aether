// Test take operator

effect Emit<T> {
    op emit(value: T) -> ();
}

fn range(start: i32, end: i32) / {Emit<i32>} {
    let mut i: i32 = start;
    while i < end {
        perform Emit.emit(i);
        i = i + 1;
    }
}

fn take<T>(stream: fn() / {Emit<T>}, n: i32) / {Emit<T>} {
    let mut count: i32 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            if count < n {
                perform Emit.emit(value);
                count = count + 1;
                resume(());
            }
        }
    };
}

fn sum(stream: fn() / {Emit<i32>}) -> i64 {
    let mut total: i64 = 0;
    try { stream(); }
    with {
        Emit.emit(value) => {
            total = total + (value as i64);
            resume(());
        }
    };
    total
}

fn main() -> i32 {
    // take first 5 from 1..100 = 1+2+3+4+5 = 15
    let result: i64 = sum(|| / {Emit<i32>} { take(|| / {Emit<i32>} { range(1, 100); }, 5); });
    if result == 15 { return 0; }
    (result as i32)
}
