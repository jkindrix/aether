// Test generic function with effectful function parameter

effect Emit<T> {
    op emit(value: T) -> ();
}

fn handle_stream<T>(stream: fn() / {Emit<T>}) {
    try { stream(); }
    with {
        Emit.emit(_value) => {
            resume(());
        }
    };
}

fn emit_number() / {Emit<i32>} {
    perform Emit.emit(42);
}

fn main() -> i32 {
    handle_stream(emit_number);
    0
}
