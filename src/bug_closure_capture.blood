// BUG REPRODUCTION: Closure parameter capture is broken
//
// When a closure captures a function parameter, it reads from the wrong
// memory location. The captured value is always the same regardless of
// what is passed to the enclosing function.

fn apply(f: fn() -> i32) -> i32 {
    f()
}

// This function should return n, but the closure doesn't capture n correctly
fn return_n(n: i32) -> i32 {
    apply(|| { n })
}

fn main() -> i32 {
    // Both calls should return their argument
    let a: i32 = return_n(100);  // Expected: 100
    let b: i32 = return_n(50);   // Expected: 50

    // But both return the same wrong value!
    if a == 100 && b == 50 {
        return 0;  // PASS: captures work correctly
    }

    if a == b {
        return 1;  // FAIL: both captured same wrong value
    }

    return 2;  // FAIL: captured different wrong values
}
